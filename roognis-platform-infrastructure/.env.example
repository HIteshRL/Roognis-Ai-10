# Copy this file to .env. Do not commit .env or put real values in image tags.
# Production images must be immutable digest references produced by each owner
# repository's release pipeline; `platform.build.compose.yaml` is integration-only.
ROOGNIS_BASE_DOMAIN=example.edu
ACME_EMAIL=ops@example.edu

POSTGRES_PASSWORD=REPLACE_WITH_A_SECRET_MANAGER_VALUE
JWT_SECRET=REPLACE_WITH_A_64_HEX_CHARACTER_SECRET
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_A_64_HEX_CHARACTER_SECRET
NEO4J_PASSWORD=REPLACE_WITH_A_SECRET_MANAGER_VALUE

# A local/DGX provider must already be qualified. The platform does not claim
# that a configured URL proves model availability or capacity.
LOCAL_LLM_BASE_URL=https://llm.internal.example/v1
LOCAL_LLM_API_KEY=REPLACE_WITH_PROVIDER_SECRET
LOCAL_LLM_MODEL=REPLACE_WITH_QUALIFIED_MODEL_ID
EMBEDDING_PROVIDER_URL=http://embedding.internal.example:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Image values MUST be full, immutable digest references in production.
TRAEFIK_IMAGE=registry.example/platform/traefik@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_IMAGE=registry.example/platform/postgres@sha256:REPLACE_WITH_64_HEX_DIGEST
REDIS_IMAGE=registry.example/platform/redis@sha256:REPLACE_WITH_64_HEX_DIGEST
CHROMADB_IMAGE=registry.example/platform/chromadb@sha256:REPLACE_WITH_64_HEX_DIGEST
NEO4J_IMAGE=registry.example/platform/neo4j@sha256:REPLACE_WITH_64_HEX_DIGEST
AUTH_IMAGE=registry.example/roognis/auth@sha256:REPLACE_WITH_64_HEX_DIGEST
AI_IMAGE=registry.example/roognis/ai@sha256:REPLACE_WITH_64_HEX_DIGEST
ANALYTICS_IMAGE=registry.example/roognis/analytics@sha256:REPLACE_WITH_64_HEX_DIGEST
QUIZ_IMAGE=registry.example/roognis/quiz@sha256:REPLACE_WITH_64_HEX_DIGEST
PRACTICE_IMAGE=registry.example/roognis/practice@sha256:REPLACE_WITH_64_HEX_DIGEST
DISCOVER_IMAGE=registry.example/roognis/discover@sha256:REPLACE_WITH_64_HEX_DIGEST
REPORTING_IMAGE=registry.example/roognis/reporting@sha256:REPLACE_WITH_64_HEX_DIGEST
RAG_IMAGE=registry.example/roognis/rag@sha256:REPLACE_WITH_64_HEX_DIGEST
LMS_IMAGE=registry.example/roognis/lms@sha256:REPLACE_WITH_64_HEX_DIGEST
KG_IMAGE=registry.example/roognis/kg@sha256:REPLACE_WITH_64_HEX_DIGEST
GNN_IMAGE=registry.example/roognis/gnn@sha256:REPLACE_WITH_64_HEX_DIGEST
DECISIONS_IMAGE=registry.example/roognis/decisions@sha256:REPLACE_WITH_64_HEX_DIGEST
PRIVACY_IMAGE=registry.example/roognis/privacy@sha256:REPLACE_WITH_64_HEX_DIGEST
PARENT_PORTAL_IMAGE=registry.example/roognis/parent-portal@sha256:REPLACE_WITH_64_HEX_DIGEST
STUDENT_PORTAL_IMAGE=registry.example/roognis/student-portal@sha256:REPLACE_WITH_64_HEX_DIGEST
TEACHER_PORTAL_IMAGE=registry.example/roognis/teacher-portal@sha256:REPLACE_WITH_64_HEX_DIGEST
