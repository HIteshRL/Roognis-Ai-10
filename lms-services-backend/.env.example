# ─────────────────────────────────────────────────────────────────────────────
# LMS / Classroom Service — standalone environment configuration
# Copy to .env and fill in values before running docker-compose up.
#
# None of these names appear in roognis-product's root .env.example — that
# file only carries the three core secrets below (shared across all services
# in the monorepo); everything else here is service-specific and was read
# straight out of services/lms/config.py (the pydantic Settings model) and
# docker-compose.yml's `lms:` block in the source monorepo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core secrets (required) ──────────────────────────────────────────────────
# Shared Postgres password. In the source monorepo this is one database
# (`roognis`) with schema-per-service; LMS owns the `lms_db` schema only.
DB_PASSWORD=

# Shared JWT secret — must match whatever Auth Service issues the `jwt`
# cookie with, since LMS only verifies tokens, it never issues them.
JWT_SECRET=

# Shared service-to-service token. Gates every /api/lms/internal/* route
# AND is the token LMS itself sends when calling Auth/Quiz/RAG/Analytics.
INTERNAL_SERVICE_TOKEN=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/roognis
LMS_DB_SCHEMA=lms_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Service identity ────────────────────────────────────────────────────────
PORT=3006
NODE_ENV=production
FILE_STORAGE_PATH=/app/storage
LMS_MAX_UPLOAD_MB=20
LMS_NOTIFICATION_SWEEP_INTERVAL_SECONDS=900
LMS_TEST_MODE=false

# ── Outbound dependencies (see README "Dependencies") ──────────────────────
# Auth Service — synchronous internal lookups: teacher/student-by-email
# (co-teacher invites, student invitations) and parent->student links
# (guardians.py). Required for those specific flows; the rest of the service
# works without it.
AUTH_SERVICE_URL=http://auth:3001

# Analytics Service — fire-and-forget classroom events
# (classroom_created, student_enrolled, coursework_published,
# coursework_submitted, coursework_graded, ...). Silently no-ops if unset.
ANALYTICS_URL=http://analytics:3004

# RAG Service — curriculum.py's fetch_context() calls
# GET /api/rag/internal/chapter-context to validate/link a document's
# chapter chunks into a CurriculumVersion. Required only for the curriculum
# bridge endpoints; returns 503 if unset when those are hit.
RAG_SERVICE_URL=http://rag:3003

# Quiz Service — Sprint 3 T3.1: coursework.py's link_quiz validates a quiz
# exists, is in the caller's school, and is status == 'ready' via
# GET /api/quiz/internal/quizzes/{quizId} before writing Coursework.quiz_id.
# NOTE: the source monorepo's docker-compose.yml (dev) sets this, but
# docker-compose.production.yml's lms block does NOT — see README for why
# that's a real discrepancy worth checking before relying on it in prod.
QUIZ_SERVICE_URL=http://quiz:3005

# ── Present in the source monorepo's docker-compose.yml but NOT read by
# services/lms/config.py today (no Settings field consumes them — pydantic's
# extra="ignore" swallows them silently). Carried here for parity/documentation
# only; safe to omit. Reserved for Layers not yet built (kg/psv/decisions) or
# services this one doesn't currently call (discover). ─────────────────────────
# PSV_SERVICE_URL=http://psv:3011
# KG_SERVICE_URL=http://kg:3012
# DECISION_SERVICE_URL=http://decisions:3014
# DISCOVER_SERVICE_URL=http://discover:3008
# LMS_SERVICE_URL=http://lms:3006
