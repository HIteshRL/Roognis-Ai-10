{
  "name": "roognis-auth",
  "version": "1.0.0",
  "description": "Roognis AI — Authentication & Identity Service",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "pretest": "prisma generate --schema=prisma/schema.prisma",
    "test": "node --test test/*.test.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "db:push": "npx prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "npx prisma migrate deploy --schema=prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.14.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
