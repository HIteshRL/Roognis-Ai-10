{
  "name": "roognis-discover",
  "version": "1.0.0",
  "description": "Roognis AI agentic Discover service (open-vocabulary interest graph, web-search news hunt, personalised feed)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:push": "npx prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "npx prisma migrate deploy --schema=prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "pretest": "prisma generate --schema=prisma/schema.prisma",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "cookie-parser": "^1.4.6",
    "express": "^5.2.1",
    "graphql": "^16.11.0",
    "graphql-http": "^1.22.4",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
